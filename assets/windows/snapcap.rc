#include <winver.h>

1 ICON "icon.ico"
1 24 "snapcap.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "SnapCap"
      VALUE "FileDescription", "SnapCap - screenshots and screen recording"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "snapcap"
      VALUE "OriginalFilename", "snapcap.exe"
      VALUE "ProductName", "SnapCap"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
